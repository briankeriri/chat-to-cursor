{
  "name": "chat-to-cursor",
  "version": "1.0.0",
  "description": "Hands-free voice interface for Cursor AI. Text-to-speech, voice commands, and conversational coding using ElevenLabs TTS.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "chat-to-cursor": "./build/index.js"
  },  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "watch": "tsc --watch",
    "settings": "node build/settings-server.js",
    "auto-submit": ".venv/bin/python scripts/auto-submit.py",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "text-to-speech",
    "elevenlabs",
    "cursor",
    "tts",
    "voice",
    "hands-free",
    "dictation",
    "model-context-protocol",
    "ai-assistant"
  ],
  "author": "Mike Sheehan",
  "contributors": [
    "Brian Keriri <bkeriri@gmail.com>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/briankeriri/chat-to-cursor"
  },
  "homepage": "https://github.com/briankeriri/chat-to-cursor",
  "files": [
    "build/",
    "public/",
    "scripts/*.py",
    "INSTALL.md",
    "README.md"
  ],
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.64.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
